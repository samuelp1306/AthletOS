# Beispiel-Konfiguration -- in `.env` kopieren und Werte eintragen.
# .env selbst ist gitignored und wird beim uvicorn-Start automatisch geladen.
ANTHROPIC_API_KEY=sk-ant-...

# Whoop-API (engine/ingest/whoop_api.py) -- EINE der beiden Varianten reicht.
# Variante A (bevorzugt): Refresh-Token aus app.whoop.com ->
#   DevTools -> Application -> Local Storage -> security.refreshToken
WHOOP_REFRESH_TOKEN=
# Variante B: Login mit Whoop-Zugangsdaten
WHOOP_EMAIL=
WHOOP_PASSWORD=
# Optional, nur falls die Token-Antwort keine User-ID liefert
WHOOP_USER_ID=
